diff --git a/ProCameraManager/Tests/EditMode/ThirdPersonLookTests.cs b/ProCameraManager/Tests/EditMode/ThirdPersonLookTests.cs
new file mode 100644
index 0000000..0a743cb
--- /dev/null
+++ b/ProCameraManager/Tests/EditMode/ThirdPersonLookTests.cs
@@ -0,0 +1,204 @@
+using System.Collections.Generic;
+using System.Reflection;
+using NUnit.Framework;
+using Unity.Cinemachine;
+using UnityEngine;
+using VectorViolet.Core.Events;
+using VectorViolet.ProCameraManager.Look;
+
+namespace VectorViolet.ProCameraManager.Tests.EditMode
+{
+    public class ThirdPersonLookTests
+    {
+        private static readonly MethodInfo Tick = typeof(ThirdPersonLook).GetMethod(
+            "Update", BindingFlags.Instance | BindingFlags.NonPublic);
+        private static readonly MethodInfo EnableInput = typeof(ThirdPersonLook).GetMethod(
+            "OnEnable", BindingFlags.Instance | BindingFlags.NonPublic);
+        private static readonly MethodInfo DisableInput = typeof(ThirdPersonLook).GetMethod(
+            "OnDisable", BindingFlags.Instance | BindingFlags.NonPublic);
+
+        private readonly List<GameObject> _objects = new();
+        private CinemachineCamera _camera;
+        private CinemachineOrbitalFollow _orbit;
+        private ThirdPersonLook _look;
+
+        [SetUp]
+        public void SetUp()
+        {
+            var cameraObject = CreateObject("Third person camera");
+            _camera = cameraObject.AddComponent<CinemachineCamera>();
+            _orbit = cameraObject.AddComponent<CinemachineOrbitalFollow>();
+            _orbit.HorizontalAxis.Value = 0f;
+            _orbit.VerticalAxis.Value = 0f;
+            _orbit.VerticalAxis.Range = new Vector2(-89f, 89f);
+
+            var lookObject = CreateObject("Player look");
+            lookObject.SetActive(false);
+            _look = lookObject.AddComponent<ThirdPersonLook>();
+            _look.SetVcam(_camera);
+            typeof(ThirdPersonLook).GetField("sensitivity", BindingFlags.Instance | BindingFlags.NonPublic)
+                .SetValue(_look, 1f);
+            lookObject.SetActive(true);
+            // This behavior does not execute in EditMode, so invoke its lifecycle explicitly.
+            EnableInput.Invoke(_look, null);
+        }
+
+        [TearDown]
+        public void TearDown()
+        {
+            if (_look) DisableInput.Invoke(_look, null);
+            for (var i = _objects.Count - 1; i >= 0; i--)
+                if (_objects[i]) Object.DestroyImmediate(_objects[i]);
+            _objects.Clear();
+        }
+
+        [Test]
+        public void NoController_PreservesEventInputFallback()
+        {
+            SendLookAndTick();
+            AssertAngles(2f, -3f);
+        }
+
+        [Test]
+        public void CinemachineWithZeroGain_DoesNotReceiveAdditionalEventRotation()
+        {
+            AddController(_camera.gameObject, _orbit, "Look Orbit X", "Look Orbit Y");
+            SendLookAndTick();
+            AssertAngles(0f, 0f);
+        }
+
+        [Test]
+        public void DisabledController_DoesNotReactivateEventFallback()
+        {
+            var controller = AddController(_camera.gameObject, _orbit, "Look Orbit X", "Look Orbit Y");
+            controller.enabled = false;
+            SendLookAndTick();
+            AssertAngles(0f, 0f);
+        }
+
+        [Test]
+        public void DisabledAxisEntries_DoNotReactivateEventFallback()
+        {
+            var controller = AddController(_camera.gameObject, _orbit, "Look Orbit X", "Look Orbit Y");
+            foreach (var axis in controller.Controllers) axis.Enabled = false;
+            SendLookAndTick();
+            AssertAngles(0f, 0f);
+        }
+
+        [Test]
+        public void HorizontalOwnedByCinemachine_VerticalStillUsesEvents()
+        {
+            AddController(_camera.gameObject, _orbit, "Look Orbit X");
+            SendLookAndTick();
+            AssertAngles(0f, -3f);
+        }
+
+        [Test]
+        public void VerticalOwnedByCinemachine_HorizontalStillUsesEvents()
+        {
+            AddController(_camera.gameObject, _orbit, "Look Orbit Y");
+            SendLookAndTick();
+            AssertAngles(2f, 0f);
+        }
+
+        [Test]
+        public void OrbitScaleController_DoesNotSuppressLookEvents()
+        {
+            AddController(_camera.gameObject, _orbit, "Orbit Scale");
+            SendLookAndTick();
+            AssertAngles(2f, -3f);
+        }
+
+        [Test]
+        public void EntriesForAnotherOwner_DoNotSuppressLookEvents()
+        {
+            var otherObject = CreateObject("Other camera");
+            otherObject.AddComponent<CinemachineCamera>();
+            var otherOrbit = otherObject.AddComponent<CinemachineOrbitalFollow>();
+            AddController(_camera.gameObject, otherOrbit, "Look Orbit X", "Look Orbit Y");
+            SendLookAndTick();
+            AssertAngles(2f, -3f);
+        }
+
+        [TestCase(true, 0f, 0f)]
+        [TestCase(false, 2f, -3f)]
+        public void AncestorController_OnlyOwnsChildAxesWhenScanningRecursively(
+            bool recursive, float horizontal, float vertical)
+        {
+            var parent = CreateObject("Camera rig");
+            _camera.transform.SetParent(parent.transform);
+            var controller = AddController(parent, _orbit, "Look Orbit X", "Look Orbit Y");
+            controller.ScanRecursively = recursive;
+            SendLookAndTick();
+            AssertAngles(horizontal, vertical);
+        }
+
+        [Test]
+        public void RemovingController_DoesNotReplayDelegatedInput()
+        {
+            var controller = AddController(_camera.gameObject, _orbit, "Look Orbit X", "Look Orbit Y");
+            SendLookAndTick();
+            Object.DestroyImmediate(controller);
+            Tick.Invoke(_look, null);
+            AssertAngles(0f, 0f);
+
+            SendLookAndTick();
+            AssertAngles(2f, -3f);
+        }
+
+        [Test]
+        public void DisablingAndReenablingLook_DiscardsOldInput()
+        {
+            EventBus<CameraRotateEvent>.Raise(new CameraRotateEvent(new Vector2(2f, 3f)));
+            _look.enabled = false;
+            DisableInput.Invoke(_look, null);
+            _look.enabled = true;
+            EnableInput.Invoke(_look, null);
+            Tick.Invoke(_look, null);
+            AssertAngles(0f, 0f);
+        }
+
+        [Test]
+        public void ReassigningCamera_DiscardsOldInput()
+        {
+            EventBus<CameraRotateEvent>.Raise(new CameraRotateEvent(new Vector2(2f, 3f)));
+            _look.SetVcam(_camera);
+            Tick.Invoke(_look, null);
+            AssertAngles(0f, 0f);
+        }
+
+        private GameObject CreateObject(string name)
+        {
+            var instance = new GameObject(name);
+            _objects.Add(instance);
+            return instance;
+        }
+
+        private static CinemachineInputAxisController AddController(
+            GameObject target, CinemachineOrbitalFollow owner, params string[] axes)
+        {
+            var controller = target.AddComponent<CinemachineInputAxisController>();
+            controller.Controllers.Clear();
+            foreach (var axis in axes)
+                controller.Controllers.Add(new InputAxisControllerBase<CinemachineInputAxisController.Reader>.Controller
+                {
+                    Owner = owner,
+                    Name = axis,
+                    Input = new CinemachineInputAxisController.Reader { Gain = 0f }
+                });
+            return controller;
+        }
+
+        private void SendLookAndTick()
+        {
+            EventBus<CameraRotateEvent>.Raise(new CameraRotateEvent(new Vector2(2f, 3f)));
+            Tick.Invoke(_look, null);
+        }
+
+        private void AssertAngles(float horizontal, float vertical)
+        {
+            Assert.That(_orbit.HorizontalAxis.Value, Is.EqualTo(horizontal).Within(0.0001f));
+            Assert.That(_orbit.VerticalAxis.Value, Is.EqualTo(vertical).Within(0.0001f));
+        }
+    }
+}
